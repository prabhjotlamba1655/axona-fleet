# AXONA FLEET MANAGEMENT - ENVIRONMENT CONFIGURATION
PORT=5055
NODE_ENV=development
JWT_SECRET=axona_fleet_jwt_secret_enterprise_2026

# Embedded SQLite (node:sqlite). No external database daemon.
# development: backend/data/dev.db unless STORAGE_PATH is set
# test: always backend/data/test/test.db (STORAGE_PATH is ignored)
# production: STORAGE_PATH is required, for example /var/lib/axona/data/prod.db
# production starts from an empty schema: no seeds.sql and no GPS simulator
# STORAGE_PATH=/var/lib/axona/data/prod.db
# DATA_DIR=./data
# Optional live snapshot interval in milliseconds (minimum 60000). Uses VACUUM INTO.
# BACKUP_INTERVAL_MS=86400000

# AIS-140 Gateway Ports
AIS140_TCP_PORT=5001
# FMB920 in the field is configured for TCP 5027. Set this to that port on Lightsail.
TELTONIKA_TCP_PORT=5027
CONCOX_TCP_PORT=5003
QUECLINK_UDP_PORT=5004

# MoRTH Emergency Backend Integration
MORTH_VAHAN_INGEST_URL=https://ais140.vahan.gov.in/telematics/v2/ingest
MORTH_PSAP_CODE=MHA-ERSS-112-MH
