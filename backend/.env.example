# AXONA FLEET MANAGEMENT - ENVIRONMENT CONFIGURATION
PORT=5055
NODE_ENV=development
JWT_SECRET=axona_fleet_jwt_secret_enterprise_2026

# Database configuration
# By default, Axona uses the built-in resilient SQLite driver (node:sqlite)
# For production PostgreSQL cloud deployment, configure:
# DATABASE_URL=postgres://axona_user:axona_secure_pwd@db.axonafleet.internal:5432/axona_fleet

# AIS-140 Gateway Ports
AIS140_TCP_PORT=5001
TELTONIKA_TCP_PORT=5002
CONCOX_TCP_PORT=5003
QUECLINK_UDP_PORT=5004

# MoRTH Emergency Backend Integration
MORTH_VAHAN_INGEST_URL=https://ais140.vahan.gov.in/telematics/v2/ingest
MORTH_PSAP_CODE=MHA-ERSS-112-MH
